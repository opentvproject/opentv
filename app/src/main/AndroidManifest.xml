<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Scheduled recordings: an exact alarm starts a booked capture at broadcast time, and the
         boot receiver re-arms future bookings after a power cycle. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Lets OpenTV ask the user to be exempted from battery optimisation ("Doze"). Without the
         exemption Android TV / Fire TV freeze the app during standby and kill an in-progress or
         scheduled recording — this is what lets a capture keep running with the box asleep, the
         same as a set-top box. The user still grants it through the system dialog. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- An "auto-switch" reminder uses a full-screen intent so a TV box changes channel on its own
         when the programme starts, the same mechanism an alarm clock uses. Degrades to a heads-up
         notification where the OS declines it. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!--
      Lets the app install the update APK it downloads itself. Sideloaded builds get no
      updates from any store, so self-update is the only route new versions reach users.
      The system still shows its own install screen and, first time, asks the user to allow
      installs from OpenTV — we never install silently.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      Declared not-required so the same APK installs on phones, tablets, Android TV and
      Fire TV. Shipping separate builds per form factor is a maintenance tax a volunteer
      project cannot afford.
    -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".OpenTvApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/cloud_backup_rules"
        android:dataExtractionRules="@xml/cloud_data_extraction_rules"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenTV"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <!--
          usesCleartextTraffic is on because the overwhelming majority of IPTV panels are
          plain HTTP. Refusing them would make the app useless for most of its users. The
          trade-off is documented in docs/PRIVACY.md.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:screenOrientation="fullUser"
            android:theme="@style/Theme.OpenTV">

            <!-- Phones and tablets -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android TV / Fire TV home screen -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="androidx.media3.session.MediaSessionService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!--
          Keeps a recording running when the user leaves the player or the screen sleeps.
          Typed mediaPlayback (not dataSync) so long captures aren't cut off by Android 14's
          six-hour daily dataSync cap — recording live TV is a media task.
        -->
        <service
            android:name=".recording.RecordingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Starts a booked recording when its alarm fires; re-arms bookings after a reboot. -->
        <receiver
            android:name=".recording.RecordingAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Fires a programme reminder when its alarm goes off; re-arms reminders after a reboot. -->
        <receiver
            android:name=".reminders.ReminderAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Serves the downloaded update APK to the system installer via a content:// uri. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
